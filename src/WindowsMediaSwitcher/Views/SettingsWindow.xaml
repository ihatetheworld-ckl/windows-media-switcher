<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsMediaSwitcher.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置 — 媒体输出切换器">

    <Grid Background="#1C1C1E" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" MaxWidth="480">
                <TextBlock Text="设置"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#F5F5F7"/>

                <!-- Hotkey -->
                <Border Background="#2C2C2E" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="全局热键" Foreground="#F5F5F7" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Name="HotkeyLabel"
                                   Foreground="#0A84FF"
                                   FontSize="18"
                                   FontFamily="Consolas"/>
                        <Button x:Name="RecordHotkeyBtn"
                                Content="录制热键…"
                                Click="OnRecordHotkey"
                                HorizontalAlignment="Left"/>
                        <TextBlock x:Name="RecordHint"
                                   Text="默认 Win+Ctrl+V。若系统占用该组合，将用底层键盘钩子拦截。"
                                   Foreground="#8E8E93"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Glass -->
                <Border Background="#2C2C2E" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Liquid Glass" Foreground="#F5F5F7" FontWeight="SemiBold" FontSize="16"/>

                        <TextBlock Text="强度" Foreground="#AEAEB2" FontSize="12"/>
                        <Slider x:Name="StrengthSlider" Minimum="20" Maximum="100" ValueChanged="OnGlassChanged"/>
                        <TextBlock Text="模糊" Foreground="#AEAEB2" FontSize="12"/>
                        <Slider x:Name="BlurSlider" Minimum="10" Maximum="80" ValueChanged="OnGlassChanged"/>
                        <TextBlock Text="高光" Foreground="#AEAEB2" FontSize="12"/>
                        <Slider x:Name="HighlightSlider" Minimum="5" Maximum="80" ValueChanged="OnGlassChanged"/>
                        <TextBlock Text="不透明度 %" Foreground="#AEAEB2" FontSize="12"/>
                        <Slider x:Name="OpacitySlider" Minimum="4" Maximum="45" ValueChanged="OnGlassChanged"/>
                        <TextBlock Text="圆角" Foreground="#AEAEB2" FontSize="12"/>
                        <Slider x:Name="RadiusSlider" Minimum="12" Maximum="48" ValueChanged="OnGlassChanged"/>

                        <TextBlock Text="预览" Foreground="#AEAEB2" FontSize="12" Margin="0,8,0,0"/>
                        <Border x:Name="PreviewGlass"
                                Height="72"
                                CornerRadius="20"
                                BorderThickness="0"
                                Padding="12">
                            <Grid>
                                <Border x:Name="PreviewHairline" Height="1" VerticalAlignment="Top" Margin="8,0"/>
                                <TextBlock Text="播放设备预览"
                                           Foreground="#F5F5F7"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <Border Background="#2C2C2E" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="行为" Foreground="#F5F5F7" FontWeight="SemiBold" FontSize="16"/>
                        <ToggleSwitch x:Name="CloseOnBlurToggle"
                                      Header="失去焦点时关闭弹窗"
                                      Toggled="OnBehaviorChanged"/>
                        <ToggleSwitch x:Name="CloseOnSelectToggle"
                                      Header="选择设备后关闭弹窗"
                                      Toggled="OnBehaviorChanged"/>
                        <ToggleSwitch x:Name="AutostartToggle"
                                      Header="开机时启动（托盘常驻）"
                                      Toggled="OnAutostartChanged"/>
                        <ToggleSwitch x:Name="CheckUpdatesToggle"
                                      Header="启动时检查更新"
                                      Toggled="OnUpdatesToggleChanged"/>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Background="#2C2C2E" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="更新" Foreground="#F5F5F7" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Name="VersionLabel"
                                   Foreground="#AEAEB2"
                                   FontSize="13"/>
                        <Button x:Name="CheckUpdateBtn"
                                Content="检查更新"
                                Click="OnCheckUpdate"
                                HorizontalAlignment="Left"/>
                        <TextBlock x:Name="UpdateStatus"
                                   Text=""
                                   Foreground="#8E8E93"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="设置保存在 %LocalAppData%\WindowsMediaSwitcher\settings.json"
                           Foreground="#636366"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
