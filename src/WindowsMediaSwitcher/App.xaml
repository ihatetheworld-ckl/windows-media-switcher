<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WindowsMediaSwitcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppWhiteTextBrush" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="AppAccentCheckBrush" Color="#0A84FF"/>
            <SolidColorBrush x:Key="AppSmokeBrush" Color="#14161C"/>
            <x:Double x:Key="PopupWidth">360</x:Double>
            <x:Double x:Key="PopupMaxHeight">480</x:Double>
            <x:Double x:Key="RowHeight">50</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
