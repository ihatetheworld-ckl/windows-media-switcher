<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsMediaSwitcher.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="Windows 媒体输出切换器">

    <!-- Hidden 1x1 host for tray + message pump. Not shown to user. -->
    <Grid x:Name="RootGrid" Width="1" Height="1" Opacity="0">
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="媒体输出切换器"
            LeftClickCommand="{x:Bind ShowPopupCommand}"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="切换输出设备" Click="OnShowPopup"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="设置" Click="OnOpenSettings"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="退出" Click="OnExit"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
